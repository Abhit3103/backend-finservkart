RewriteEngine On

# Skip rewrite rules for /admin, /customer, /CA, and /agent folders
RewriteCond %{REQUEST_URI} ^/(admin|customer|CA|agent) [NC]
RewriteRule ^ - [L]

# Redirect HTTP to HTTPS (only for live domain, not localhost)
RewriteCond %{HTTP_HOST} ^(www\.)?finservkart\.com$ [NC]
RewriteCond %{SERVER_PORT} 80
RewriteRule ^(.*)$ https://finservkart.com/$1 [R=301,L]

# Disable MultiViews to prevent Apache from rewriting URLs automatically
Options +FollowSymLinks -MultiViews

# Ensure DirectoryIndex works correctly
DirectoryIndex index.php index.html

# Remove .php extension but keep it accessible manually
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^(.+?)$ $1.php [L]

# Rewrite URLs to remove .php extension for cleaner URLs (only for live site)
RewriteCond %{HTTP_HOST} ^(www\.)?finservkart\.com$ [NC]
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s([^.]+)\.php [NC]
RewriteRule ^ %1 [R=301,L]